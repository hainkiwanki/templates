{
    "name": "@templates/backend",
    "description": "Template for backend applications with bare minimum linting",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "author": "hainkiwanki",
    "license": "MIT",
    "packageManager": "yarn@4.9.1",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/index.mts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write ."
    },
    "dependencies": {
        "fastify": "^5.6.1"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@fastify/type-provider-typebox": "^6.1.0",
        "@sinclair/typebox": "^0.34.45",
        "@types/node": "^24.8.0",
        "@typescript-eslint": "^8.12.0",
        "eslint": "^9.37.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "files": [
        "src"
    ]
}
